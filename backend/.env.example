# --- Core ---
APP_ENV=development
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./aether.db

# --- LLM (provider abstraction; Gemini is default) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=gemini

# --- Memory ---
BREETH_API_KEY=

# --- Scheduler ---
PUBLISH_INTERVAL_MINUTES=60
