# --- Core ---
APP_ENV=production
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./aether.db

# --- LLM (OpenRouter is primary; Gemini is an optional fallback) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional fallback provider — only needed if you set LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Memory (Breeth primary memory layer) ---
BREETH_API_KEY=
BREETH_BASE_URL=https://api.thebreeth.com

# --- Scheduler ---
PUBLISH_INTERVAL_MINUTES=30
